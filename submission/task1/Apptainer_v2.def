Bootstrap: docker

From: pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

%labels
    Author Amirhossein Rasoulian
    Challenge FOMO26
    Task Task 1 - Infarct Classification
    Version v2.0.0
    Description FOMO26 Infarct Classification 5-Fold ViT Ensemble

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONPATH=/app

    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    export CC=/usr/bin/gcc
    export CXX=/usr/bin/g++
    export CUDAHOSTCXX=/usr/bin/g++

    export TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_cache
    export TRITON_CACHE_DIR=/tmp/triton_cache

    export MODEL_DIR=/app/model
    export CHECKPOINT_NAME=best
    export NUM_FOLDS=5

    export ASPARAGUS_DATA=/input
    export ASPARAGUS_MODELS=/app/model
    export ASPARAGUS_RESULTS=/output
    export ASPARAGUS_CONFIGS=/app/configs
    export ASPARAGUS_RAW_LABELS=/app/raw_labels

    export ASPARAGUS_PRETRAIN_CONFIGS=/app/configs
    export ASPARAGUS_TRAIN_CONFIGS=/app/configs
    export ASPARAGUS_FINETUNE_CONFIGS=/app/configs
    export ASPARAGUS_EVAL_BOX_CONFIGS=/app/configs

    export WANDB_MODE=disabled
    export WANDB_SILENT=true

    export OMP_NUM_THREADS=1
    export MKL_NUM_THREADS=1

%files
    # Build from:
    # /scratch/01/ahrasoulian/projects/fomo26

    fomo26-lesion-impossible/submission/task1/predict_v2.py /app/predict.py

    fomo26-lesion-impossible/requirements.txt /app/requirements.txt
    fomo26-lesion-impossible/asparagus /app/asparagus
    fomo26-lesion-impossible/configs /app/configs

    # Each copied directory must contain:
    #   hydra/config.yaml or .hydra/config.yaml
    #   checkpoints/best.ckpt

    models/CLS002_FOMO26_Infarct/task_vit_b_cls__3D/script=finetune_cls/root=lesion_impossible__stem=finetune/leaf=projects/lesion_impossible/finetune/v2_cls.yaml__clargs=data.fold=0/split_80_20_00__fold=0/run_id=106998 /app/model/fold_0
    models/CLS002_FOMO26_Infarct/task_vit_b_cls__3D/script=finetune_cls/root=lesion_impossible__stem=finetune/leaf=projects/lesion_impossible/finetune/v2_cls.yaml__clargs=data.fold=1/split_80_20_00__fold=1/run_id=631091 /app/model/fold_1
    models/CLS002_FOMO26_Infarct/task_vit_b_cls__3D/script=finetune_cls/root=lesion_impossible__stem=finetune/leaf=projects/lesion_impossible/finetune/v2_cls.yaml__clargs=data.fold=2/split_80_20_00__fold=2/run_id=897989 /app/model/fold_2
    models/CLS002_FOMO26_Infarct/task_vit_b_cls__3D/script=finetune_cls/root=lesion_impossible__stem=finetune/leaf=projects/lesion_impossible/finetune/v2_cls.yaml__clargs=data.fold=3/split_80_20_00__fold=3/run_id=196908 /app/model/fold_3
    models/CLS002_FOMO26_Infarct/task_vit_b_cls__3D/script=finetune_cls/root=lesion_impossible__stem=finetune/leaf=projects/lesion_impossible/finetune/v2_cls.yaml__clargs=data.fold=4/split_80_20_00__fold=4/run_id=694689 /app/model/fold_4

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONPATH=/app

    export CC=/usr/bin/gcc
    export CXX=/usr/bin/g++
    export CUDAHOSTCXX=/usr/bin/g++

    apt-get update

    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libc6-dev

    mkdir -p \
        /app/raw_labels \
        /tmp/torchinductor_cache \
        /tmp/triton_cache

    grep -viE \
        '^[[:space:]]*(torch|torchvision|torchaudio|triton|nvidia-[A-Za-z0-9_.-]+)([<>=!~[:space:]].*)?$' \
        /app/requirements.txt \
        > /app/requirements-runtime.txt

    python -m pip install \
        --no-cache-dir \
        --no-compile \
        --prefer-binary \
        -r /app/requirements-runtime.txt

    # Fail during the build if any fold is incomplete.
    fold=0
    while [ "$fold" -lt 5 ]; do
        test -d "/app/model/fold_${fold}"
        test -f "/app/model/fold_${fold}/checkpoints/best.ckpt"

        if [ -f "/app/model/fold_${fold}/hydra/config.yaml" ]; then
            :
        elif [ -f "/app/model/fold_${fold}/.hydra/config.yaml" ]; then
            :
        else
            echo "Missing Hydra config for fold_${fold}" >&2
            exit 1
        fi

        fold=$((fold + 1))
    done

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec python /app/predict.py "$@"