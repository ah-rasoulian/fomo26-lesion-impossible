Bootstrap: docker

From: pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

%labels
    Author Amirhossein Rasoulian
    Challenge FOMO26
    Task Tasks 6 and 7 - Linear Probing and Bias and Fairness
    Version v1.0.0
    Description FOMO26 Frozen Pretrained Embeddings Apptainer Image

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONPATH=/app

    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    # Required by TorchInductor and Triton.
    export CC=/usr/bin/gcc
    export CXX=/usr/bin/g++
    export CUDAHOSTCXX=/usr/bin/g++

    # Writable runtime compilation caches.
    export TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_cache
    export TRITON_CACHE_DIR=/tmp/triton_cache

    # Pretrained model location.
    export MODEL_DIR=/app/model
    export CHECKPOINT_NAME=last

    # Required Asparagus paths.
    export ASPARAGUS_DATA=/input
    export ASPARAGUS_MODELS=/app/model
    export ASPARAGUS_RESULTS=/output
    export ASPARAGUS_CONFIGS=/app/configs
    export ASPARAGUS_RAW_LABELS=/app/raw_labels

    export ASPARAGUS_PRETRAIN_CONFIGS=/app/configs
    export ASPARAGUS_TRAIN_CONFIGS=/app/configs
    export ASPARAGUS_FINETUNE_CONFIGS=/app/configs
    export ASPARAGUS_EVAL_BOX_CONFIGS=/app/configs

    export WANDB_MODE=disabled
    export WANDB_SILENT=true

    export OMP_NUM_THREADS=1
    export MKL_NUM_THREADS=1

%files
    # Build from:
    # /scratch/01/ahrasoulian/projects/fomo26

    # Shared Task 6/7 challenge entry point.
    fomo26-lesion-impossible/submission/task6_and_7/predict.py /app/predict.py

    # Python requirements.
    fomo26-lesion-impossible/requirements.txt /app/requirements.txt

    # Required application source and configurations.
    fomo26-lesion-impossible/asparagus /app/asparagus
    fomo26-lesion-impossible/configs /app/configs

    # Pretrained model used to generate frozen embeddings.
    models/PT902_FOMO300K_HF/sma_resunet_s__3D/script=pretrain/root=lesion_impossible__stem=pretrain/leaf=projects/lesion_impossible/pretrain/sma_resunet_s_1.yaml__clargs=training.accumulate_grad_batches=1,training.batch_size=4,training.max_samples=1000000/split_99_01_00__fold=0/run_id=578257 /app/model

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONPATH=/app

    export CC=/usr/bin/gcc
    export CXX=/usr/bin/g++
    export CUDAHOSTCXX=/usr/bin/g++

    # Install the minimal compiler toolchain needed by TorchInductor/Triton.
    apt-get update

    apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        libc6-dev

    # Create the required empty directory.
    mkdir -p /app/raw_labels

    # Keep the PyTorch, Triton, and CUDA packages supplied by the base image.
    grep -viE \
        '^[[:space:]]*(torch|torchvision|torchaudio|triton|nvidia-[A-Za-z0-9_.-]+)([<>=!~[:space:]].*)?$' \
        /app/requirements.txt \
        > /app/requirements-runtime.txt

    # Install runtime Python dependencies without a pip download cache or
    # compiled Python bytecode.
    python -m pip install \
        --no-cache-dir \
        --no-compile \
        --prefer-binary \
        -r /app/requirements-runtime.txt

    chmod +x /app/predict.py

%runscript
    exec python /app/predict.py "$@"

%help
    This container generates frozen pretrained embeddings for FOMO26 Tasks 6
    and 7.

    Build from /scratch/01/ahrasoulian/projects/fomo26 with:

        apptainer build --fakeroot task6_and_7.sif task6_and_7.def

    Usage:

        apptainer run --nv \
            --bind /path/to/input:/input:ro \
            --bind /path/to/output:/output \
            task6_and_7.sif \
            --input /input/image.nii.gz \
            --output /output/embedding.npy
