Bootstrap: docker

From: pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

%labels
    Author Amirhossein Rasoulian
    Challenge FOMO26
    Task Tasks 6 and 7 - Linear Probing and Bias and Fairness
    Version v3.0.0
    Description FOMO26 BrainDINO v3 raw CLS-token embeddings

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONPATH=/app

    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    export CC=/usr/bin/gcc
    export CXX=/usr/bin/g++
    export CUDAHOSTCXX=/usr/bin/g++
    export TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_cache
    export TRITON_CACHE_DIR=/tmp/triton_cache

    export MODEL_DIR=/app/model
    export CHECKPOINT_NAME=last

    export ASPARAGUS_DATA=/input
    export ASPARAGUS_MODELS=/app/model
    export ASPARAGUS_RESULTS=/output
    export ASPARAGUS_CONFIGS=/app/configs
    export ASPARAGUS_RAW_LABELS=/app/raw_labels
    export ASPARAGUS_PRETRAIN_CONFIGS=/app/configs
    export ASPARAGUS_TRAIN_CONFIGS=/app/configs
    export ASPARAGUS_FINETUNE_CONFIGS=/app/configs
    export ASPARAGUS_EVAL_BOX_CONFIGS=/app/configs

    export WANDB_MODE=disabled
    export WANDB_SILENT=true
    export OMP_NUM_THREADS=1
    export MKL_NUM_THREADS=1

%files
    # Build from /scratch/01/ahrasoulian/projects/fomo26.
    fomo26-lesion-impossible/submission/task6_and_7/predict_v3.py /app/predict.py
    fomo26-lesion-impossible/requirements.txt /app/requirements.txt
    fomo26-lesion-impossible/asparagus /app/asparagus
    fomo26-lesion-impossible/configs /app/configs

    # BrainDINO v3 pretrained run used by downstream tasks (run ID 606554).
    models/PT902_FOMO300K_HF/pretrain_braindino_vit_s__3D/script=pretrain_subjectwise/root=lesion_impossible__stem=pretrain/leaf=projects/lesion_impossible/pretrain/v3.yaml__clargs=training.resume_ckpt=4/split_99_01_00__fold=0/run_id=606554 /app/model

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONPATH=/app
    export CC=/usr/bin/gcc
    export CXX=/usr/bin/g++
    export CUDAHOSTCXX=/usr/bin/g++

    apt-get update
    apt-get install -y --no-install-recommends gcc g++ libc6-dev
    rm -rf /var/lib/apt/lists/*

    mkdir -p /app/raw_labels

    # Retain the CUDA/PyTorch stack supplied by the base image.
    grep -viE \
        '^[[:space:]]*(torch|torchvision|torchaudio|triton|nvidia-[A-Za-z0-9_.-]+)([<>=!~[:space:]].*)?$' \
        /app/requirements.txt \
        > /app/requirements-runtime.txt

    python -m pip install \
        --no-cache-dir \
        --no-compile \
        --prefer-binary \
        -r /app/requirements-runtime.txt

    chmod +x /app/predict.py

%test
    python -m py_compile /app/predict.py
    test -f /app/model/checkpoints/last.ckpt
    test -f /app/model/hydra/config.yaml -o -f /app/model/.hydra/config.yaml

%runscript
    exec python /app/predict.py "$@"

%help
    Generates the raw final CLS-token embedding from the frozen student
    BrainDINO v3 backbone. The saved array is float32 with shape (embed_dim,):
    384 for ViT-S or 768 for ViT-B.

    Build from /scratch/01/ahrasoulian/projects/fomo26:

        apptainer build --fakeroot task6_and_7_v3.sif \
            fomo26-lesion-impossible/submission/task6_and_7/apptainer_v3.def

    Run:

        apptainer run --nv \
            --bind /path/to/input:/input:ro \
            --bind /path/to/output:/output \
            task6_and_7_v3.sif \
            --input /input/image.nii.gz \
            --output /output/embedding.npy
